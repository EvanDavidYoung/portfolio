---
const currentPath = Astro.url.pathname

const navItems = [
  {
    label: 'About',
    href: '/',
    active: currentPath === '/',
  },
  {
    label: 'Projects',
    href: '/projects',
    active: currentPath === '/projects',
  },
  {
    label: 'Chinese',
    href: '/chinese-language-learning',
    active: currentPath === '/chinese-language-learning' || currentPath === '/one-year-in-taiwan',
  },
]
---

<nav class="sidebar">
  {
    navItems.map(({ label, href, active }) => (
      <a href={href} class:list={['nav-link', { active }]}>
        {label}
      </a>
    ))
  }
</nav>

<style>
  .sidebar {
    position: fixed;
    top: 6rem;
    left: 3rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .nav-link {
    font-size: var(--font-size-s);
    color: var(--text-tertiary);
    text-decoration: none;
    transition: color 0.2s ease-out;
    white-space: nowrap;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--text-primary);
  }

  @media (max-width: 768px) {
    .sidebar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      flex-direction: row;
      gap: 1.5rem;
      padding: 0.875rem 1.35rem;
      background-color: var(--bg);
      border-bottom: 1px solid var(--border);
      z-index: 100;
      transition: background-color 0.2s ease-out;
    }
  }
</style>
