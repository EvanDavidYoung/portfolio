<!--
  Minimal theme block — light mode only. Prevents flash on load and
  preserves the correct class across Astro view transitions.
-->
<style is:inline>
  :root {
    --bg: #ffffff;
  }

  html {
    background-color: var(--bg);
    color-scheme: light;
  }

  html.no-transition,
  html.no-transition * {
    transition: none !important;
  }
</style>

<script is:inline data-cfasync="false">
  ;(function () {
    if (window.__themeApplied) return
    window.__themeApplied = true

    document.documentElement.classList.remove('dark')
    document.documentElement.classList.add('light')

    document.documentElement.classList.add('no-transition')
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        document.documentElement.classList.remove('no-transition')
      })
    })

    document.addEventListener('astro:before-swap', (e) => {
      e.newDocument.documentElement.classList.remove('dark')
      e.newDocument.documentElement.classList.add('light')
    })

    document.addEventListener('astro:after-swap', () => {
      document.documentElement.classList.remove('dark')
      document.documentElement.classList.add('light')
    })
  })()
</script>
