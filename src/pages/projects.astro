---
import { themeConfig } from '@/config'
import IndexLayout from '@/layouts/IndexLayout.astro'
import { projects } from '@/data/projects'
---

<IndexLayout title={`Projects · ${themeConfig.site.title}`} description="Things I've built, at work and on my own.">
  <div class="projects">
    <p class="intro" data-animate style="--stagger:1">Things I've built, at work and on my own.</p>

    {
      projects.map((project, i) => (
        <article class="card" data-animate style={`--stagger:${i + 2}`}>
          <div class="card-media">
            {project.media?.type === 'video' ? (
              <video
                src={project.media.src}
                poster={project.media.poster}
                aria-label={project.media.alt}
                muted
                loop
                playsinline
                preload="metadata"
                data-autoplay
              />
            ) : project.media?.type === 'image' ? (
              <img src={project.media.src} alt={project.media.alt} loading="lazy" decoding="async" />
            ) : (
              <div class="card-placeholder" aria-hidden="true">
                {project.name}
              </div>
            )}
          </div>
          <div class="card-body">
            <div class="card-head">
              {project.href ? (
                <a class="card-title" href={project.href} target="_blank" rel="noopener noreferrer">
                  {project.name}
                </a>
              ) : (
                <span class="card-title">{project.name}</span>
              )}
            </div>
            {project.stack && <p class="card-stack">{project.stack}</p>}
            <p class="card-desc">{project.description}</p>
          </div>
        </article>
      ))
    }
  </div>
</IndexLayout>

<script>
  // Autoplay clips only when the user hasn't asked for reduced motion; otherwise the poster stays.
  function playClips() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return
    document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]').forEach((video) => {
      video.play().catch(() => {})
    })
  }
  document.addEventListener('astro:page-load', playClips)
</script>

<style>
  .projects {
    margin-top: 1rem;
    margin-bottom: 2rem;
  }

  .intro {
    font-size: var(--font-size-m);
    color: var(--text-secondary);
    margin: 0 0 2rem;
  }

  .card {
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    overflow: hidden;
    margin-bottom: 1.5rem;
  }

  .card-media {
    aspect-ratio: 16 / 10;
    border-bottom: 1px solid var(--border);
    background-color: rgba(0, 0, 0, 0.03);
  }

  .card-media img,
  .card-media video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  /* No screenshot yet: a short band instead of a tall empty frame. */
  .card-media:has(.card-placeholder) {
    aspect-ratio: 4 / 1;
  }

  .card-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: 1rem;
    background-image: radial-gradient(var(--border) 1px, transparent 1px);
    background-size: 12px 12px;
    text-align: center;
    font-size: var(--font-size-l);
    font-weight: var(--font-weight-bold);
    color: var(--text-tertiary);
  }

  .card-body {
    padding: 0.875rem 1rem 1rem;
  }

  .card-title {
    font-size: var(--font-size-m);
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
    text-decoration: none;
  }

  a.card-title {
    text-decoration: underline;
    text-decoration-color: var(--text-tertiary);
    transition: text-decoration-color 0.2s ease-out;
  }

  a.card-title:hover {
    text-decoration-color: var(--text-primary);
  }

  .card-stack {
    font-size: var(--font-size-s);
    color: var(--text-tertiary);
    margin: 0.15rem 0 0;
    padding: 0;
  }

  .card-desc {
    font-size: var(--font-size-s);
    color: var(--text-secondary);
    line-height: 1.65;
    margin: 0.4rem 0 0;
    padding: 0;
  }
</style>
